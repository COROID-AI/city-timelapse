{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2020"
    ],
    "jsx": "preserve",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "noEmit": true,
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests"
  ]
}