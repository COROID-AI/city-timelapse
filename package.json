{
  "name": "city-timelapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "City Time Period Timelapse — a 3D city block that transforms across the eras 1945–2055. Procedurally rendered with Three.js on a Vite + TypeScript foundation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "~0.185.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
