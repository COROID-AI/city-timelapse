    "test:vitest": "vitest run src/scenes/layout/__tests__ src/scenes/atmosphere.test.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}