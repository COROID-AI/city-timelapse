{
  "name": "city-time-period-timelapse",
  "version": "0.1.0",
  "private": true,
  "description": "3D city block timelapse across eras. Shared era-invariant block layout anchors, the era-domain contracts/dataset/interpolation engine, and the top timeline slider UI owning era selection state.",
  "scripts": {
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev-server.mjs",
    "dev:qa": "vite --port 5173 --strictPort",
    "test": "jest && vitest run src/scenes",
    "test:jest": "jest",
    "test:vitest": "vitest run src/scenes/layout/__tests__ src/scenes/storefronts/__tests__ src/scenes/navigation/__tests__ src/scenes/buildings/__tests__",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.1"
  }
}
